# ==============================================================================
# Risk Alert Dashboard - Production Environment Configuration Template
# Usage: cp .env.production.example .env.production
# Fill in real credentials and deploy via: docker compose -f docker-compose.prod.yml up -d --build
# ==============================================================================

# Database Configuration (PostgreSQL Container)
# IMPORTANT: Generate a strong, unique password for production!
POSTGRES_USER=risk_alert_prod_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PRODUCTION_PASSWORD
POSTGRES_DB=risk_alert_prod_db
DATABASE_URL=postgresql+asyncpg://risk_alert_prod_user:CHANGE_ME_TO_STRONG_PRODUCTION_PASSWORD@postgres:5432/risk_alert_prod_db

# Security & Authentication
# Generate a secure 64-character random key using: openssl rand -hex 32
SECRET_KEY=GENERATE_RANDOM_SECRET_KEY_USING_OPENSSL
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_ADMIN_PASSWORD
ADMIN_EMAIL=security-admin@corp.domain

VIEWER_USERNAME=viewer
VIEWER_PASSWORD=CHANGE_ME_TO_STRONG_VIEWER_PASSWORD
VIEWER_EMAIL=security-viewer@corp.domain

# API Documentation Credentials (/docs & /openapi.json basic auth)
DOCS_USERNAME=docs_admin
DOCS_PASSWORD=CHANGE_ME_TO_STRONG_DOCS_PASSWORD

# Server Worker Concurrency (Default: 4 workers)
WORKERS=4

# Frontend HTTP Port (Default: 3000 to avoid conflicts with host port 80)
FRONTEND_PORT=3000

# Qualys Cloud Platform API Configuration
QUALYS_API_URL=https://qualysapi.qualys.com
QUALYS_USERNAME=your_qualys_api_username
QUALYS_PASSWORD=your_qualys_api_password
QUALYS_MOCK_MODE=false
QUALYS_SYNC_INTERVAL_HOURS=6
QUALYS_TAG_FILTER=

# MISP Threat Intelligence (FS-ISAC / Internal MISP) Configuration
MISP_URL=https://misp.internal.corp
MISP_API_KEY=your_production_misp_auth_key
MISP_CREATOR_ORG=FS-ISAC
MISP_TAG_FILTER=vulnerability:CVE%
MISP_FEED_TAG=FS-ISAC
MISP_ENABLED=true
MISP_MOCK_MODE=false
MISP_SYNC_INTERVAL_HOURS=2

# MISP ZeroMQ Real-Time Stream (Optional)
MISP_ZMQ_ENABLED=false
MISP_ZMQ_HOST=misp.internal.corp
MISP_ZMQ_PORT=50000
MISP_ZMQ_USERNAME=
MISP_ZMQ_PASSWORD=

# Telegram Alert Bot Configuration (Optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COOLDOWN_HOURS=6
