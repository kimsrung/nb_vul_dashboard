# ==============================================================================
# Risk Alert Dashboard - Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://risk_alert_user:risk_alert_secret_password@localhost:5432/risk_alert_db

POSTGRES_USER=risk_alert_user
POSTGRES_PASSWORD=risk_alert_secret_password
POSTGRES_DB=risk_alert_db

# Security & Authentication
SECRET_KEY=qualys-risk-alert-super-secret-key-change-in-production-2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@internal.security

VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer123
VIEWER_EMAIL=viewer@internal.security

# Qualys Cloud Platform API Configuration
QUALYS_API_URL=https://qualysapi.qualys.com
QUALYS_USERNAME=
QUALYS_PASSWORD=

# Set to true for offline demo mode (uses realistic built-in XML payloads)
# Set to false to connect directly to your live Qualys account
QUALYS_MOCK_MODE=true

# Background Sync Interval (Hours)
QUALYS_SYNC_INTERVAL_HOURS=6

# Optional: Scope ingestion to specific Asset Tag names (comma-separated or empty for all)
QUALYS_TAG_FILTER=

# MISP Threat Intelligence (FS-ISAC / CIRCL / Local Docker) Configuration
MISP_URL=https://localhost:8443
MISP_API_KEY=
MISP_CREATOR_ORG=CIRCL
MISP_TAG_FILTER=
MISP_FEED_TAG=CIRCL
MISP_ENABLED=true
MISP_MOCK_MODE=false
MISP_SYNC_INTERVAL_HOURS=2
MISP_ZMQ_ENABLED=false
MISP_ZMQ_HOST=localhost
MISP_ZMQ_PORT=50000
MISP_ZMQ_USERNAME=
MISP_ZMQ_PASSWORD=

# Telegram Alert Bot Configuration (Optional)
# 1. Create a bot via @BotFather in Telegram to get the BOT_TOKEN
# 2. Add the bot to your security channel/group and get the CHAT_ID
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COOLDOWN_HOURS=6
